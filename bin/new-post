#!/usr/bin/env bash
# Create a new trip post as a page bundle with the right folder name + front matter.
#
#   bin/new-post "The Bell Inn, Somewhere"              # dated today
#   bin/new-post "The Bell Inn, Somewhere" 2026-07-04   # explicit trip date
#
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

title=${1:?usage: bin/new-post "Post Title" [YYYY-MM-DD]}
date=${2:-$(date +%F)}
[[ $date =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "bad date: $date (want YYYY-MM-DD)" >&2; exit 1; }

py='import sys,re,datetime,unicodedata as u; t,d0=sys.argv[1],sys.argv[2]; s=u.normalize("NFKD",t).encode("ascii","ignore").decode().lower(); s=re.sub(r"[^a-z0-9]+","-",s).strip("-") or "post"; d=datetime.date.fromisoformat(d0); o={1:"st",2:"nd",3:"rd"}.get(d.day if d.day<20 else d.day%10,"th"); print(s); print(str(d.day)+o+" "+d.strftime("%B %Y"))'
out=$(python3 -c "$py" "$title" "$date")
slug=$(printf '%s\n' "$out" | sed -n 1p)
pretty=$(printf '%s\n' "$out" | sed -n 2p)

dir="content/posts/${date}-${slug}"
file="$dir/index.md"
[ -e "$file" ] && { echo "already exists: $file" >&2; exit 1; }

mkdir -p "$dir"
{
  echo '---'
  printf 'title: "%s"\n' "${title//\"/\\\"}"
  echo "date: ${date}"
  echo 'draft: false'
  printf 'slug: "%s"\n' "$slug"
  echo "wp_published: ${date}"
  echo '---'
  echo
  echo "$pretty"
  echo
} > "$file"

echo "created $file"
command -v code >/dev/null 2>&1 && code "$file" || true
